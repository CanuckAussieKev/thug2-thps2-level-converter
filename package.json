{
  "name": "thug2-thps2-level-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "THUG2 THPS2 Level Converter: Tony Hawk's Pro Skater 2 (PC) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thps2-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./thps2_levels/pkr.ts": {
      "types": "./thps2_levels/pkr.ts",
      "default": "./thps2_levels/pkr.js"
    },
    "./package.json": "./package.json"
  },
  "commands": [
    "thps2_levels/thps2_levels.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#265d9857e3cb880f66899a0880a11d95ec9fa569"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
